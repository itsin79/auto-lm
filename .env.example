# تنظیمات اختیاری اجرای محلی اتو ال‌ام
HOST=127.0.0.1
PORT=4173

# پیش‌فرض پایگاه داده .data/autolm.sqlite است.
# AUTOLM_DB_PATH=.data/autolm.sqlite

# برای همگام‌سازی MCP، یک توکن تصادفی محلی تعیین کنید و همان را
# در auto-lm-plugin/.dev.vars با نام AUTOLM_ADMIN_SYNC_TOKEN قرار دهید.
# AUTOLM_MCP_SYNC_TOKEN=
# AUTOLM_DEFAULT_INSPECTOR=
# AUTOLM_PUBLIC_ORIGIN=http://127.0.0.1:4173
